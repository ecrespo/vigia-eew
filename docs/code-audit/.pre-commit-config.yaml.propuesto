# Pre-commit hooks — mirror the GitHub Actions gates locally (ci.yml + security.yml).
#
# Two stages so commits stay fast:
#   pre-commit (every commit): hygiene, ruff, mypy, bandit, gitleaks
#   pre-push   (before push):  pytest, pip-audit, semgrep, trivy
#
# Install both hook types once:  uv run pre-commit install
# Run everything on demand:      uv run pre-commit run --all-files --hook-stage pre-push
default_install_hook_types: [pre-commit, pre-push]
default_stages: [pre-commit]

repos:
  # ── Hygiene ────────────────────────────────────────────────
  - repo: https://github.com/pre-commit/pre-commit-hooks
    rev: v5.0.0
    hooks:
      - id: trailing-whitespace
        exclude: '\.geojson$'
      - id: end-of-file-fixer
        exclude: '\.geojson$'
      - id: check-yaml
      - id: check-toml
      - id: check-merge-conflict
      - id: check-added-large-files
        args: [--maxkb=5120]

  # ── Secrets (matches security.yml gitleaks version) ────────
  - repo: https://github.com/gitleaks/gitleaks
    rev: v8.21.2
    hooks:
      - id: gitleaks

  # ── Project tools via uv (parity with CI commands + lockfile) ──
  - repo: local
    hooks:
      # -- pre-commit stage (fast) --
      - id: ruff
        name: ruff (lint)
        entry: uv run --extra dev --extra security ruff check .
        language: system
        pass_filenames: false
        always_run: true

      - id: mypy
        name: mypy (strict)
        entry: uv run --extra dev --extra security mypy src
        language: system
        pass_filenames: false
        always_run: true

      - id: bandit
        name: bandit (SAST)
        entry: uv run --extra dev --extra security bandit -r src --severity-level=medium
        language: system
        pass_filenames: false
        always_run: true

      # -- pre-push stage (slower / network) --
      - id: pytest
        name: pytest (unit tests)
        entry: uv run --extra dev --extra security pytest -q
        language: system
        pass_filenames: false
        always_run: true
        stages: [pre-push]

      - id: pip-audit
        name: pip-audit (dependency CVEs)
        entry: uv run --extra dev --extra security pip-audit --skip-editable
        language: system
        pass_filenames: false
        always_run: true
        stages: [pre-push]

      - id: semgrep
        name: semgrep (SAST — OWASP/python/secrets over src/)
        entry: uvx semgrep scan --config=p/python --config=p/secrets --config=p/owasp-top-ten --error --metrics=off src/
        language: system
        pass_filenames: false
        always_run: true
        stages: [pre-push]

      - id: trivy
        name: trivy fs (HIGH,CRITICAL) — best-effort locally
        # Runs only if the trivy binary is installed; CI (security.yml) is the
        # authoritative gate, so a dev without trivy isn't blocked.
        entry: bash -c 'if command -v trivy >/dev/null 2>&1; then trivy fs . --scanners vuln,misconfig,secret --severity HIGH,CRITICAL --exit-code 1 --no-progress; else echo "trivy no instalado — omitido en local (el CI lo exige)"; fi'
        language: system
        pass_filenames: false
        always_run: true
        stages: [pre-push]

  # ══════════════════════════════════════════════════════════════
  # Añadido por la auditoría (docs/code-audit/02-PLAN-REMEDIACION.md)
  # Cierra los gaps de las dimensiones 1 (DRY), 2 (complejidad) y 3
  # (cobertura). Ningún hook existente fue modificado ni eliminado.
  # ══════════════════════════════════════════════════════════════
  - repo: local
    hooks:
      # -- R-02: formato como gate, no como criterio de revisión --
      - id: ruff-format
        name: "format: ruff format --check"
        entry: uv run --extra dev --extra security ruff format --check .
        language: system
        pass_filenames: false
        always_run: true

      # -- R-04: complejidad cognitiva (dimensión 2) --
      # Umbral 16 temporalmente: rest_geofon.py:_process_text está en 16.
      # Bajar a 12 al cerrar P3-5.
      - id: cognitive-complexity
        name: "complexity: flake8 CCR001 (max=16, objetivo 12)"
        entry: uv run --with flake8 --with flake8-cognitive-complexity flake8 --select=CCR001 --max-cognitive-complexity=16 src/
        language: system
        pass_filenames: false
        always_run: true

      # -- R-04: complejidad estructural (dimensión 2) --
      - id: lizard
        name: "complexity: lizard (CCN<=15, length<=200)"
        entry: uv run --with lizard lizard src/ --CCN 15 --length 200 -w
        language: system
        pass_filenames: false
        always_run: true

      # -- R-01: cobertura con umbral, en pre-push (necesita la suite) --
      # NOTA: sustituye al hook `pytest` de arriba (misma etapa pre-push).
      # Al adoptar este config, eliminar el hook `pytest` original para no
      # ejecutar la suite dos veces.
      - id: pytest-cov
        name: "tests: pytest + cobertura con umbral"
        entry: uv run --extra dev --extra security pytest -q --cov=vigia_eew --cov-branch --cov-fail-under=70
        language: system
        pass_filenames: false
        always_run: true
        stages: [pre-push]

      # -- R-04: duplicación (dimensión 1) — pre-push por coste de npx --
      - id: jscpd
        name: "dry: jscpd (>3% duplicado bloquea)"
        entry: bash -c 'if command -v npx >/dev/null 2>&1; then npx --yes jscpd@4 src --min-tokens 70 --threshold 3 --reporters console; else echo "npx no disponible — omitido en local (revisar en CI)"; fi'
        language: system
        pass_filenames: false
        always_run: true
        stages: [pre-push]

  # -- Higiene adicional recomendada por la plantilla del skill --
  - repo: https://github.com/pre-commit/pre-commit-hooks
    rev: v5.0.0
    hooks:
      - id: check-json
        exclude: '\.geojson$'
      - id: detect-private-key
      - id: debug-statements
      - id: check-ast
